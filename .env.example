# LLM: OpenAI-совместимый API. В программе Sber500 — шлюз к Cloud.ru Foundation Models
# (ключ выдают организаторы). Без ключа или модели работает разбор правилами.
LLM_BASE_URL=https://shared1.multitool.works:4000/v1
LLM_API_KEY=
LLM_MODEL=

# База: локально SQLite-файл; на сервере PostgreSQL задаётся в docker-compose.yml
DATABASE_URL=sqlite:///./family_dispatcher.db

# Вход по телефону: SMS.RU, авторизация звонком
SMSRU_API_ID=

# App
APP_ENV=local
TIMEZONE=Europe/Moscow
CORS_ORIGINS=http://localhost:5173
# Токен для /api/v1/analytics/* (заголовок X-Admin-Token)
ADMIN_TOKEN=change-me
# Соль для обезличенных идентификаторов в выгрузках аналитики
ANALYTICS_SALT=change-me

# Только для сервера (docker-compose): пароль PostgreSQL и домены для HTTPS
POSTGRES_PASSWORD=
DOMAIN=

# Web Push (VAPID) и подпись ссылок из уведомлений. Сгенерировать: python deploy/gen_keys.py >> .env
# Без ключей VAPID push выключены, приложение работает.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SECRET_KEY=
