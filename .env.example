# GigaChat (без ключа работает резервный разбор правилами)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL=false

# Storage: локально SQLite-файл; для PostgreSQL —
# postgresql+psycopg://postgres:postgres@localhost:5432/family_dispatcher
DATABASE_URL=sqlite:///./family_dispatcher.db
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=local
TIMEZONE=Europe/Moscow
CORS_ORIGINS=http://localhost:5173
# Токен для GET /api/v1/analytics/daily (заголовок X-Admin-Token)
ADMIN_TOKEN=change-me
